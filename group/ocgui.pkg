; SymbianOverclock: on-device CPU/bus overclocking for OMAP2420 (N95 8GB).
; ASCII only, CRLF only: makesis misparses UTF-8 and LF line endings.
;
; Shaped like daemon.pkg - the package shape this phone is known to install:
; executable plus registration resource, installed to C:.
;
; Installed to C: on purpose. Executables on C: skip the removable-media hash
; check, and the path stays deterministic across memory-card changes.
;
; NOT included: patcher.ldd from RomPatcher+. That driver carries kernel-side
; capabilities a self-signed certificate cannot grant, so bundling it would make
; the whole package fail to install. It has to be present already - the app says
; so plainly when it is missing.
;
; Nothing here runs at boot: no startup-list resource, no autostart. The
; overclock is applied only by hand, from inside the application, and any
; reboot returns the phone to stock.

&EN

#{"SymbianOverclock"},(0xE0001011),1,4,0

%{"SymbianOverclock"}
:"SymbianOverclock"

[0x101F7961],0,0,0,{"Series60ProductID"}

"\VsCodeProjects\SymbianProjects\S60_3rd_FP1\Epoc32\release\gcce\urel\ocgui.exe"-"c:\sys\bin\ocgui.exe"
"\VsCodeProjects\SymbianProjects\S60_3rd_FP1\Epoc32\data\z\resource\apps\ocgui.RSC"-"c:\resource\apps\ocgui.rsc"
"\VsCodeProjects\SymbianProjects\S60_3rd_FP1\Epoc32\data\z\private\10003a3f\import\apps\ocgui_reg.RSC"-"c:\private\10003a3f\import\apps\ocgui_reg.rsc"
