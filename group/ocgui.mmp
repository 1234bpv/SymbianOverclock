// Overclock application with an on-device UI.
//
// UID2 is zero, as in the daemon and in stage1 PS1Emulator: what makes the EXE
// an application is the registration file, not UID2. 0x100039CE would only add
// risk here - packages with it failed to install on this device.

TARGET          ocgui.exe
TARGETTYPE      exe
UID             0 0xE0001011
SECUREID        0xE0001011
VENDORID        0

// The same set as the probe: PowerMgmt is the most likely check in
// DDVFSChannel::DoCreate, the rest ensure that a channel failure is a meaningful
// conclusion rather than a consequence of missing capability. ReadDeviceData is not
// part of the self-signed set, so the package can only be installed on an already
// unlocked device.
// CommDD added 2026-09-09: on E90 the host for the READ/EXEC primitive is the Usbc
// USB client driver, and its DoCreate returns -46 without CommDD. Without this line,
// the app starts on E90, but the engine remains NOT READY.
CAPABILITY      PowerMgmt WriteDeviceData ReadDeviceData ReadUserData WriteUserData ProtServ CommDD

// The relock blob and clock measurement rely on fixed ARM encoding: in THUMB
// both register allocation and instruction costs differ.
ALWAYS_BUILD_AS_ARM

EPOCSTACKSIZE   0x5000
// 2 MB for test buffer plus headroom: the working set must be significantly larger
// than the cache, otherwise the bus test would measure the cache.
EPOCHEAPSIZE    0x10000 0x800000

SOURCEPATH      ..\src
SOURCE          ocgui.cpp
SOURCE          ocengine.cpp
SOURCE          ocstr.cpp

// Application resource. Name must match app_file in ocgui_reg.rss -
// the framework looks specifically for \resource\apps\<app_file>.rsc.
// HEADER generates ocgui.rsg, which ocgui_reg.rss includes to name the
// localisable resource holding the caption and the icon.
START RESOURCE  ocgui.rss
TARGET          ocgui
TARGETPATH      \resource\apps
HEADER
END

START RESOURCE  ocgui_reg.rss
TARGETPATH      \private\10003a3f\import\apps
END

SYSTEMINCLUDE   \epoc32\include

LIBRARY         euser.lib
LIBRARY         efsrv.lib
LIBRARY         hal.lib
LIBRARY         sysutil.lib
LIBRARY         apparc.lib
LIBRARY         cone.lib
LIBRARY         eikcore.lib
LIBRARY         eikcoctl.lib
LIBRARY         avkon.lib
LIBRARY         ws32.lib
LIBRARY         gdi.lib
LIBRARY         bafl.lib
