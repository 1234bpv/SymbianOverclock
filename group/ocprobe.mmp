// DVFS probe. There is no console output - the daemon runs it without a terminal,
// so the report is written to E:\ocprobe.log, which the PC then retrieves via GET.

TARGET          ocprobe.exe
TARGETTYPE      exe
UID             0 0xE0001010
SECUREID        0xE0001010
VENDORID        0

// PowerMgmt is the most likely candidate for checking in DDVFSChannel::DoCreate.
// The rest are to ensure failure is not due to another, secondary reason: if the
// channel fails to open, it must be a meaningful conclusion, not a consequence of
// missing permissions to write the log.
// Broad set: E90 scan attempts to open arbitrary kernel channels, and different
// drivers check different capabilities (CommDD, MultimediaDD, NetworkControl...).
// To ensure that open failure indicates actual channel unavailability rather than
// missing capabilities, we include everything accepted by a dev certificate on a hacked
// device (everything except production TCB/AllFiles/DRM).
CAPABILITY      PowerMgmt WriteDeviceData ReadDeviceData ReadUserData WriteUserData ProtServ CommDD MultimediaDD NetworkControl NetworkServices LocalServices Location SwEvent TrustedUI SurroundingsDD UserEnvironment DiskAdmin

// Absolute clock measurement relies on inline assembly with fixed clock cycle
// cost per instruction. In THUMB, register allocation and encoding differ,
// so the target is built as ARM.
ALWAYS_BUILD_AS_ARM

EPOCSTACKSIZE   0x5000
EPOCHEAPSIZE    0x10000 0x800000

SOURCEPATH      ..\src
SOURCE          ocprobe.cpp
SOURCE          ocengine.cpp

SYSTEMINCLUDE   \epoc32\include

LIBRARY         euser.lib
LIBRARY         efsrv.lib
LIBRARY         hal.lib
LIBRARY         sysutil.lib
LIBRARY         fbscli.lib
LIBRARY         bitgdi.lib
LIBRARY         gdi.lib
