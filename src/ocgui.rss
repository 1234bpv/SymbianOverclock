// AVKON application resource. Without it CEikApplication will not start: the framework
// opens <app_file>.rsc even before creating AppUi. Resource order is fixed -
// 1 = signature, 2 = default document name, 3 = EIK_APP_INFO.
//
// Menu and CBA are intentionally omitted: the window is fullscreen, all controls are via
// joystick, exit is via right softkey or Esc (handled by the control itself).

NAME OCTL

#include <eikon.rh>
#include <appinfo.rh>

RESOURCE RSS_SIGNATURE { }

RESOURCE TBUF { buf = ""; }

RESOURCE EIK_APP_INFO
	{
	}

// Name and icon shown by the shell. Two captions, because the shell uses two:
// the long one in list view and in the application manager, the short one under
// the icon in the grid, where anything past about a dozen characters is cut.
//
// The icon is an .mbm rather than an .mif - see group\icons.mk. number_of_icons
// counts icon/mask pairs in it, and there are three, one per size.
RESOURCE LOCALISABLE_APP_INFO r_localisable_app_info
	{
	short_caption = "Overclock";
	caption_and_icon = CAPTION_AND_ICON_INFO
		{
		caption = "Symbian Overclock";
		number_of_icons = 3;
		icon_file = "\\resource\\apps\\ocgui_aif.mbm";
		};
	}
