// Application registration: without it the EXE resides in \sys\bin and cannot be launched
// from the menu. The name must be exactly <app_file>_reg.rsc, otherwise apparc does not
// pick up the record.

#include <appinfo.rh>

UID2 KUidAppRegistrationResourceFile
UID3 0xE0001011

RESOURCE APP_REGISTRATION_INFO
	{
	app_file = "ocgui";
	hidden = KAppNotHidden;
	embeddability = KAppNotEmbeddable;
	newfile = KAppDoesNotSupportNewFile;
	launch = KAppLaunchInForeground;
	}
