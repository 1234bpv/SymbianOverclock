# Artefacts and logs (project rule: out/ is not committed)
out/*

# Developer signing material: the private key does not go into the repository
sign/

# Files generated by the build
group/ABLD.BAT
*.sis

# EPOC / Symbian intermediate build files
*.o
*.o.d
*.dso
*.in
*.map
*.sym

# System
Thumbs.db
Desktop.ini
.DS_Store

# Packages unpacked by dumpsis (for inspecting .sis contents)
SymbianOverclock_sha1/
group/SymbianOverclock_sha1/

# Offline analyses of ROM images - the only thing under out/ that the
# repository needs: README and docs/PORTING.md refer to them as porting
# material. The images themselves (out/roms/) stay out of git: they are
# other people's firmware.
!out/analysis/
