# Нормалізувати перенос рядків у текстових файлах
* text=auto

# Скрипти Windows тримати з CRLF (cmd/bat ламаються від LF)
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Джерела й документація — LF
*.cpp  text eol=lf
*.h    text eol=lf
*.js   text eol=lf
*.md   text eol=lf
*.mmp  text eol=lf
*.rss  text eol=lf
*.inf  text eol=lf

# .pkg мусить лежати в робочій копії з CRLF: makesis мовчки псує файл із LF,
# і про це прямо сказано в коментарі всередині ocgui.pkg. Раніше тут стояло
# eol=lf, тобто свіжий клон отримав би несправний пакет; на цій машині це не
# спливло лише тому, що робоча копія жодного разу не перевикачувалась.
*.pkg  text eol=crlf

# Бінарні артефакти
*.sis   binary
*.rom   binary
*.bmp   binary
*.png   binary
