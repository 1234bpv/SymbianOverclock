# Normalise line endings in text files
* text=auto

# Windows scripts stay CRLF (cmd/bat break on LF)
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Sources and documentation - LF
*.cpp text eol=lf
*.h   text eol=lf
*.js  text eol=lf
*.md  text eol=lf
*.txt text eol=lf
*.rss text eol=lf
*.mmp text eol=lf
*.inf text eol=lf
*.json text eol=lf

# The .pkg must sit in the working copy with CRLF: makesis silently corrupts a
# file with LF endings, which is stated outright in a comment inside ocgui.pkg.
# This used to say eol=lf, meaning a fresh clone would have produced a broken
# package; it never surfaced on this machine only because the working copy was
# never re-cloned.
*.pkg text eol=crlf

# Binary artefacts
*.sis binary
*.sisx binary
*.exe binary
*.dll binary
*.ldd binary
*.rom binary
*.bin binary
